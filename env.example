# Job Radar: environment variables (template, placeholders only).
#
# For local development, copy this to ~/.config/jobradar/local.env (OUTSIDE the repo),
# uncomment what you need and fill in real values there. scripts/dev.sh loads that file.
#   mkdir -p ~/.config/jobradar && cp env.example ~/.config/jobradar/local.env && chmod 600 ~/.config/jobradar/local.env
# Never put real values in this file or anywhere in the repo (.gitignore blocks *.env and local.env).
# In prod, Cloud Run gets these from OpenTofu and Secret Manager, and the API refuses every local-only shortcut.

# ---------------------------------------------------------------- AI (models)
# vertex = live models (dev.sh's default; the backend alone defaults to replay); replay = recorded answers, offline (opt-in); record = live + save fixtures (human-run).
#LLM=vertex
# Only with LLM=replay: answer unrecorded prompts with labelled synthetic output (dev.sh sets this for replay).
#LLM_REPLAY_MISS=synthesize
# Where live Claude calls go: vertex (prod path) or anthropic (local only, e.g. while Vertex quota is pending).
#CLAUDE_BACKEND=vertex
#ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Vertex: your GCP project (ADC via `gcloud auth application-default login`). dev.sh copies it to GCP_PROJECT.
#GOOGLE_CLOUD_PROJECT=proj-xxxx
#VERTEX_REGION=global
#MAAS_REGION=us-central1
# Let the research agent use Claude's web search server tool (off by default; see docs/security.md).
#RESEARCH_WEB_SEARCH=false
# Budgets and spend are shown in AUD; providers bill in USD, converted at this rate (must be > 0).
#USD_TO_AUD=1.55
# Default monthly LLM budget in AUD when a maintainer hasn't set one in Settings (unset = no cap).
#LLM_BUDGET_MONTH_AUD=50

# ---------------------------------------------------------------- Safety guards
# fake = in-process fakes (offline); gcp = Model Armor + Sensitive Data Protection (needs the templates below).
#GUARDS=fake
#MODEL_ARMOR_LOCATION=australia-southeast1
#MODEL_ARMOR_TEMPLATE=projects/proj-xxxx/locations/australia-southeast1/templates/xxxx
#SDP_LOCATION=australia-southeast1
#SDP_DEIDENTIFY_TEMPLATE=projects/proj-xxxx/locations/australia-southeast1/deidentifyTemplates/xxxx
#SDP_REIDENTIFY_TEMPLATE=projects/proj-xxxx/locations/australia-southeast1/deidentifyTemplates/xxxx
#SDP_INSPECT_TEMPLATE=projects/proj-xxxx/locations/australia-southeast1/inspectTemplates/xxxx
# Runtime denylist of sensitive identifiers for the redaction filter: inline, or a file with one per line.
#DENYLIST=proj-xxxx
#DENYLIST_FILE=/home/you/.config/jobradar/denylist.txt

# ---------------------------------------------------------------- Sign-in
# fake = `Authorization: Bearer fake:<email>` (local and tests only); identity_platform = real JWTs (prod).
#AUTH=fake
# The two allowed accounts. dev.sh uses owner@example.test / tester@example.test placeholders if unset.
#APP_USERS=[{"email":"owner@example.test","role":"maintainer"},{"email":"tester@example.test","role":"user"}]
#APP_USERS_FILE=/home/you/.config/jobradar/users.json
#IDP_PROJECT_ID=proj-xxxx
#IDP_TENANT_ID=

# ---------------------------------------------------------------- Database
# dev.sh starts a disposable Postgres (Docker, else embedded) and sets this for you.
# The API must connect as a restricted login granted jobradar_app (it refuses to start as a superuser).
#DATABASE_URL=postgresql://jobradar_dev_app:xxxx@127.0.0.1:5432/jobradar
#DB_POOL_SIZE=5

# ---------------------------------------------------------------- Storage, scan and campaign
# Profile documents and uploads: local disk (default) or a GCS bucket (prod). dev.sh points at fake GCS when Docker runs.
#STORAGE=local
#STORAGE_BUCKET=jobradar-xxxx
# The scan: roles released per user per run, and (local only) the in-process schedule. dev.sh sets 15; prod uses Cloud Scheduler.
#SCAN_BATCH_SIZE=5
#SCAN_INTERVAL_MINUTES=15
# The campaign plan (default config/campaign.yaml). Point at a private plan outside the repo.
#CAMPAIGN_CONFIG=/home/you/.config/jobradar/campaign.yaml

# ---------------------------------------------------------------- API limits and logging
# Local e2e only: multiplies every rate-limit tier (1-20). dev.sh sets 10. Prod is pinned to 1.
#RATE_LIMIT_SCALE=10
#RATE_LIMIT_IP_SALT=change-me-in-prod
#TRUSTED_PROXY_HOPS=0
#MAX_BODY_BYTES=1048576
#LOG_LEVEL=INFO
# local | test | prod. prod enforces vertex, gcp guards, identity_platform and the rest.
#ENVIRONMENT=local

# ---------------------------------------------------------------- Web (Next.js)
# The private api service behind the web BFF proxy (dev.sh: http://127.0.0.1:8000).
#API_INTERNAL_URL=http://127.0.0.1:8000
# Prod only: Google ID token audience for calling the IAM-only api service.
#API_ID_TOKEN_AUDIENCE=https://api-xxxx.a.run.app
# Build-time (public by design): fake | identity. Unset, it follows AUTH (so AUTH=fake also gives fake sign-in);
# production builds default to identity.
#NEXT_PUBLIC_AUTH_MODE=fake
#NEXT_PUBLIC_FIREBASE_API_KEY=xxxx
#NEXT_PUBLIC_FIREBASE_TENANT_ID=

# ---------------------------------------------------------------- Local tooling
# dev.sh: claude-only | cross-model (cross-model needs Vertex for Gemini).
#REVIEW=claude-only
# Playwright workers against the single dev server.
#E2E_WORKERS=2
# Playwright e2e signs in through the real sign-in page (identity mode) as these two accounts:
# a maintainer and a user from APP_USERS, email-verified, without MFA. Specs skip when unset.
# Put real values only in ~/.config/jobradar/local.env; the e2e helpers read them from there.
#E2E_OWNER_EMAIL=owner@example.test
#E2E_OWNER_PASSWORD=xxxx
#E2E_TESTER_EMAIL=tester@example.test
#E2E_TESTER_PASSWORD=xxxx
# check.sh denylist gate: the denylist file it scans the repo against (default: ~/.config/jobradar/denylist.txt).
#JOBRADAR_DENYLIST=/home/you/.config/jobradar/denylist.txt
# Seed builder: secret salt for fake employer names (default: ~/.config/jobradar/seed_salt).
#JOBRADAR_SEED_SALT=
