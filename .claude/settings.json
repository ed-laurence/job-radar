{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  },
  "outputStyle": "terse",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.sh\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.sh\"", "timeout": 180 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-tests.sh\"", "timeout": 600 }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-check.sh\"", "timeout": 30 }]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git tag:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo create:*)",
      "Bash(gh api:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(gcloud * create:*)",
      "Bash(gcloud * deploy:*)",
      "Bash(gcloud * delete:*)",
      "Bash(gcloud * update:*)",
      "Bash(gcloud services enable:*)",
      "Bash(gcloud * add-iam-policy-binding:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(../general/job-seeker/profile/**)",
      "Read(../general/job-seeker/.env)"
    ]
  }
}
