# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser, and they are public by design (ARCH-43).

# fake | identity. Unset means fake in dev/test and identity in production builds.
# AUTH=fake (the backend's switch) is also honoured.
NEXT_PUBLIC_AUTH_MODE=fake

# Identity Platform mode only. The web API key is public by design (restricted by referrer
# and to the Identity Toolkit API). Email/password sign-in needs no authDomain or project id.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Optional: Identity Platform tenant id, if a tenant is used.
NEXT_PUBLIC_FIREBASE_TENANT_ID=

# Server-side only (never NEXT_PUBLIC_): where /api/* is proxied to. scripts/dev.sh sets it.
API_BASE_URL=http://127.0.0.1:8000

# Playwright: the running web app (scripts/dev.sh) and the API health URL.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_HEALTH_URL=http://127.0.0.1:8000/healthz
